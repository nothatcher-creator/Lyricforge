eight:800}.eyebrow{color:#aa96ff}.subtle{color:#838b9d;font-size:10.5px}
button{border-radius:7px;background:linear-gradient(180deg,#1a1d26,#151720);border-color:#303441;color:#d9dde6;box-shadow:0 1px 0 rgba(255,255,255,.025) inset}button:hover{background:linear-gradient(180deg,#222632,#1b1e28);border-color:#3d4251}.primary{letter-spacing:-.01em}
.field input,.field select,.field textarea,input[type=text],input[type=url],input[type=password],input[type=number],select,textarea{background:#0b0d12;border-color:#2a2d38;border-radius:7px;color:#f0f2f6}.field input:focus,.field select:focus,.field textarea:focus,textarea:focus,input:focus{border-color:#7967bd;box-shadow:0 0 0 3px rgba(141,105,255,.10)}
.ai-section{margin:-2px -2px 14px;padding:12px;border:1px solid #332d42;border-radius:11px;background:radial-gradient(circle at 90% 5%,rgba(141,105,255,.13),transparent 36%),linear-gradient(145deg,rgba(255,66,104,.055),rgba(141,105,255,.045));box-shadow:0 8px 26px rgba(0,0,0,.13)}.privacy-badge{border:1px solid rgba(70,215,150,.2);background:rgba(70,215,150,.07);color:#76dfae;border-radius:999px;padding:3px 6px;font-size:8px;font-weight:750;letter-spacing:.04em;white-space:nowrap}.privacy-badge.large{align-self:flex-start;font-size:9px;padding:5px 8px}.ai-launch{width:100%;display:grid;grid-template-columns:30px 1fr auto;align-items:center;text-align:left;gap:8px;padding:10px!important;border-radius:9px!important;background:linear-gradient(135deg,#3a2130,#2a213d)!important;border:1px solid #563b57!important;box-shadow:none!important}.ai-launch:hover{border-color:#8a5979!important;transform:translateY(-1px)}.ai-launch .ai-spark{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#ff4a6d,#a05dff);font-size:14px}.ai-launch b,.ai-launch small{display:block}.ai-launch b{font-size:11px}.ai-launch small{font-size:8.5px;color:#b9adbd;margin-top:2px;font-weight:500}.ai-launch .chevron{font-size:20px;color:#8f8192}.ai-facts{display:flex;gap:6px;margin-top:7px}.ai-facts span{font-size:8px;border:1px solid #2d303a;color:#8c94a6;background:#11131a;border-radius:5px;padding:3px 5px}.sync-grid button{padding:6px 4px;font-size:9px}.lyric-search-row{position:sticky;top:-13px;z-index:5;background:#101118;padding:8px 0}.empty-state{border:1px dashed #303440;background:#0d0f15;border-radius:9px;display:grid;place-items:center;text-align:center;padding:22px 12px;color:#7e8799}.empty-state span{font-size:20px;color:#555d70}.empty-state b{color:#bfc5d0;font-size:10px;margin-top:5px}.empty-state small{font-size:9px;max-width:200px;margin-top:2px}.empty-state.compact{padding:16px 10px}
.asset-card,.lyric-row,.preset-card{border-color:#272a34;background:linear-gradient(180deg,#151720,#11131a);border-radius:8px}.asset-card:hover,.lyric-row:hover,.preset-card:hover{border-color:#3a3e4c}.lyric-row.selected{border-color:#8d506d;background:linear-gradient(90deg,#20131a,#17141d);box-shadow:inset 2px 0 #ff4268}.preset-card{min-height:68px;box-shadow:0 8px 18px rgba(0,0,0,.08)}
.stage-wrap{background:#08090d}.stage-toolbar{height:38px;background:#0e1016;border-color:#232631;padding-inline:12px}.crumb{font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:#747c8f}.stage{background-color:#090a0f;background-image:linear-gradient(45deg,#0d0f15 25%,transparent 25%),linear-gradient(-45deg,#0d0f15 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#0d0f15 75%),linear-gradient(-45deg,transparent 75%,#0d0f15 75%);background-size:20px 20px;box-shadow:inset 0 0 90px rgba(0,0,0,.25)}#previewCanvas{border-radius:5px;box-shadow:0 28px 80px rgba(0,0,0,.52),0 0 0 1px #343742}
.transport{background:linear-gradient(180deg,#101219,#0c0e13);border-color:#262934;gap:20px}.transport button{width:30px;height:30px;display:grid;place-items:center;padding:0;background:transparent;border-color:transparent;color:#939caf}.transport button:hover{background:#1c1f28;color:#fff;border-color:#303441}.transport .play{width:36px;h