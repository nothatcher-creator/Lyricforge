 result=tapSync(sorted,i,state.playheadUs,true);state.commit(p=>{const map=new Map(result.events.map(x=>[x.id,x]));p.lyrics=p.lyrics.map(x=>map.get(x.id)||x);});tapSyncIndex=result.nextIndex;const next=result.events[result.nextIndex];if(next)state.selectLyric(next.id);}

function handleTrackHeaderClick(e){const b=e.target.closest('[data-track-action]');if(!b)return;const head=e.target.closest('[data-track]'),id=head.dataset.track,a=b.dataset.trackAction;state.commit(p=>{const t=p.tracks.find(x=>x.id===id);if(!t)return;if(['visible','locked','muted'].includes(a))t[a]=!t[a];else{const sorted=[...p.tracks].sort((x,y)=>x.order-y.order),i=sorted.findIndex(x=>x.id===id),j=a==='up'?Math.max(0,i-1):Math.min(sorted.length-1,i+1);if(i!==j){[sorted[i].order,sorted[j].order]=[sorted[j].order,sorted[i].order];}}});}
$('#trackHeaders').addEventListener('click',handleTrackHeaderClick);
$('#tracks').addEventListener('pointerdown',e=>{const clip=e.target.closest('.clip');if(clip){const kind=clip.dataset.kind,id=clip.dataset.id,append=e.ctrlKey||e.metaKey;if(kind==='lyric')state.selectLyric(id,append);else state.selectClip(id,append);const obj=kind==='lyric'?state.project.lyrics.find(x=>x.id===id):state.project.clips.find(x=>x.id===id);const edge=e.target.dataset.edge||'move';dragState={kind,id,edge,startX:e.clientX,startUs:obj.startUs,endUs:obj.endUs,node:clip};clip.setPointerCapture?.(e.pointerId);e.preventDefault();return;}const row=e.target.closest('.track-row');if(!row)return;if(e.shiftKey){const rect=timelineContent.getBoundingClientRect();boxState={x0:e.clientX-rect.left+timelineScroll.scrollLeft,y0:e.clientY-rect.top+timelineScroll.scrollTop};const box=$('#selectionBox');box.style.display='block';box.style.left=`${boxState.x0}px`;box.style.top=`${boxState.y0}px`;box.style.width='0';box.style.height='0';}else{const rect=timelineContent.getBoundingClientRect();state.setPlayhead(usForX(e.clientX-rect.left+timelineScroll.scrollLeft));audio.seekUs(state.playheadUs);}});
window.addEventListener('pointermove',e=>{if(dragState){const dx=e.clientX-dragState.startX,du=Math.round(dx/pxPerUs());let start=dragState.startUs,end=dragState.endUs;if(dragState.edge==='left')start=Math.min(end-10_000,Math.max(0,start+du));else if(dragState.edge==='right')end=Math.max(start+10_000,end+du);else{start=Math.max(0,start+du);end=start+(dragState.endUs-dragState.startUs);}dragState.preview={start,end};dragState.node.style.left=`${xForUs(start)}px`;dragState.node.style.width=`${Math.max(8,xForUs(end-start))}px`;}if(boxState){const rect=timelineContent.getBoundingClientRect(),x=e.clientX-rect.left+timelineScroll.scrollLeft,y=e.clientY-rect.top+timelineScroll.scrollTop,box=$('#selectionBox');box.style.left=`${Math.min(x,boxState.x0)}px`;box.style.top=`${Math.min(y,boxState.y0)}px`;box.style.width=`${Math.abs(x-boxState.x0)}px`;box.style.height=`${Math.abs(y-boxState.y0)}px`;boxState.x=x;boxState.y=y;}});
window.addEventListener('pointerup',()=>{if(dragState){let {start,end}=dragState.preview||{start:dragState.startUs,end:dragState.endUs};if($('#snapToggle').checked){const s=snapTimeUs(start,{thresholdUs:80_000,playheadUs:state.playheadUs,beats:state.project.beats,markers:state.project.markers,lyrics:state.project.lyrics.filter(x=>x.id!==dragState.id),clips:state.project.clips.filter(x=>x.id!==dragState.id)});const delta=s.timeUs-start;if(s.source){start+=delta;if(dragState.edge==='move')end+=delta;}}if(dragState.kind==='lyric')state.updateLyric(dragState.id,{startUs:start,endUs:end});else state.commit(p=>{const c=p.clips.find(x=>x.id===dragState.id);c.startUs=start;c.endUs=end;});dragState=null;}if(boxState){const box=$('#selectionBox'),br=box.getBoundingClientRect();state.selected.lyrics.clear();state.selected.clips.clear();for(const el of $$('.clip')){const r=el.getBoundingClientRect();if(r.right>=br.left&&r.left<=br.right&&r.bottom>=br.top&&r.top<=br.bottom){(el.dataset.kind==='lyric'?state.selected.lyrics:state.selected.clips).add(el.dataset.id);}}box.style.display='none';boxState=null;state.emit('selection');}});

canvas.addEventListener('pointerdown',e=>{const clip=selectedClip(),lyric=selectedLyric();if(!clip&&!lyric)return;const rect=canvas.getBoundingClientRect(),start={x:e.clientX,y:e.clientY};const origin=clip?(clip.type==='text'?{x:(clip.content?.style?.x??state.project.titleStyle.x),y:(clip.content?.style?.y??state.project.titleStyle.y)}:{x:clip.transform?.x??.5,y:clip.transform?.y??.5}):{x:state.project.lyricStyle.x,y:state.project.lyricStyle.y};const move=ev=>{const nx=Math.max(0,Math.min(1,origin.x+(ev.clientX-start.x)/rect.width)),ny=Math.max(0,Math.min(1,origin.y+(ev.clientY-start.y)/rect.height));if(clip){const c=state.project.clips.find(x=>x.id===clip.id);if(c.type==='text')c.content.style={...(c.content.style||{}),x:nx,y:ny};else c.transform={...(c.transform||{}),x:nx,y:ny};}else{state.project.lyricStyle.x=nx;state.project.lyricStyle.y=ny;}renderFrame();};const up=ev=>{window.removeEventListener('pointermove',move);window.removeEventListener('pointerup',up);const nx=Math.max(0,Math.min(1,origin.x+(ev.clientX-start.x)/rect.width)),ny=Math.max(0,Math.min(1,origin.y+(ev.clientY-start.y)/rect.height));if(clip)state.commit(p=>{const c=p.clips.find(x=>x.id===clip.id);if(c.type==='text')c.content.style={...(c.content.style||{}),x:nx,y:ny};else c.transform={...(c.transform||{}),x:nx,y:ny};});else state.commit(p=>{p.lyricStyle.x=nx;p.lyricStyle.y=ny;});};window.addEventListener('pointermove',move);window.addEventListener('pointerup',up);});

async function showOpenModal(){const ps=await listProjects();modalBody.innerHTML=`<div class="modal-card"><h2>Open Project</h2><p class="subtle">Projects and media stay in this browser's local storage.</p>${ps.map(p=>`<div class="project-row"><div><b>${esc(p.name)}</b><div class="subtle">${new Date(p.modifiedAt).toLocaleString()} · ${p.lyrics.length} lyric lines</div></div><button type="button" data-open-project="${p.id}">Open</button></div>`).join('')||'<p>No saved projects yet.</p>'}<div class="modal-actions"><button value="cancel">Close</button></div></div>`;modal.showModal();}
modalBody.addEventListener('click',async e=>{const id=e.target.dataset.openProject;if(id){const p=await loadProject(id);if(p){modal.close();await loadIntoEditor(p);toast('Project opened','good');}}});

function showNewModal(){modalBody.innerHTML=`<div class="modal-card"><h2>New Lyric Video</h2><label class="field"><span>Project name</span><input id="newName" value="Untitled Lyric Video"></label><div class="two-col"><label class="field"><span>Aspect</span><select id="newAspect"><option>16:9</option><option>9:16</option><option>1:1</option><option>4:5</option><option>21:9</option></select></label><label class="field"><span>Resolution</span><select id="newRes"><option>720p</option><option selected>1080p</option><option>1440p</option><option>4k</option></select></label></div><div class="modal-actions"><button value="cancel">Cancel</button><button type="button" class="primary" id="createProject">Create</button></div></div>`;modal.showModal();$('#createProject',modalBody).onclick=()=>{const p=createProject($('#newName').value||'Untitled Lyric Video'),aspect=$('#newAspect').value,res=$('#newRes').value,r=resolveResolution(res,aspect);p.composition.aspect=aspect;p.composition.width=r.width;p.composition.height=r.height;modal.close();state.replace(p,{dirty:true});restoreAssets();};}

function showTranscriptionModal(){
  const hasAudio=!!runtime.audioBlob,support=browserWhisperSupport();
  modalBody.innerHTML=`<div class="modal-card transcription-modal">
    <div class="modal-hero"><div class="modal-icon ai-glow">✦</div><div><span class="eyebrow">BUILT-IN AI</span><h2>Auto Detect Lyrics</h2><p>Turn the imported song into editable lyrics with line and word timing.</p></div><span class="privacy-badge large">● Runs on this device</span></div>
    <div class="tx-provider-card selected"><div><b>Built-in Whisper</b><small>No endpoint, API key, account, or upload required.</sma