px;color:#aeb5c5;margin-bottom:6px}

/* LyricForge v0.3 — creative-app polish */
:root{
  --bg:#08090d;--panel:#101118;--panel2:#151721;--line:#292c38;--line-soft:#1e202a;
  --soft:#9198aa;--text:#f5f6fa;--accent:#ff4268;--accent2:#8d69ff;--cyan:#57d8ff;
  --surface:#13151d;--surface2:#191c27;--shadow:0 18px 60px rgba(0,0,0,.32);
  --radius:10px;
}
body{font-feature-settings:"cv02","cv03","cv04","cv11";background:#07080b}
.app-shell{background:radial-gradient(1000px 520px at 52% -240px,rgba(117,79,225,.24),transparent 64%),#08090e}
.topbar{height:auto;padding:0 14px;gap:11px;background:linear-gradient(180deg,rgba(17,18,25,.98),rgba(11,12,17,.97));border-bottom-color:#2a2d38;box-shadow:0 1px 0 rgba(255,255,255,.025);backdrop-filter:blur(24px)}
.brand{gap:10px}.brand-mark{position:relative;width:34px;height:34px;border-radius:10px;background:linear-gradient(145deg,#ff4d72 0%,#a349e3 52%,#6b70ff 100%);box-shadow:0 0 0 1px rgba(255,255,255,.09) inset,0 8px 28px rgba(143,70,225,.28)}.brand-mark:after{content:"";position:absolute;inset:3px;border-radius:8px;border:1px solid rgba(255,255,255,.11)}.brand-mark span{position:relative;z-index:1}.brand strong{font-size:13px;letter-spacing:-.01em}.brand strong em{font-style:normal;color:#888fa0;font-weight:600;font-size:9px;letter-spacing:.08em;text-transform:uppercase;margin-left:4px}.brand span{margin-top:3px;color:#777f91}
.top-actions{gap:4px}.top-actions button{border-color:transparent;background:transparent;color:#bdc3d0;padding:6px 8px}.top-actions button:hover{background:#1c1f29;border-color:#2b2f3d;color:#fff}.top-actions .secondary-save{color:#858d9f}.top-actions .ai-top-action{background:linear-gradient(180deg,#22202c,#1b1924);border-color:#3b344d;color:#e6dfff;font-weight:700;padding-inline:11px}.top-actions .ai-top-action:hover{border-color:#755ca0;background:#292336;box-shadow:0 0 20px rgba(141,105,255,.09)}.top-actions .export-action{background:linear-gradient(135deg,#ff4166,#df2d8f);color:white;border:0;padding-inline:13px;box-shadow:0 7px 20px rgba(255,48,102,.18)}.export-action span{opacity:.75;margin-left:3px}
.status-pill{display:flex;align-items:center;gap:6px;border-color:#292c37;background:#11131a;color:#9199ab;padding:5px 9px}.status-pill i{width:6px;height:6px;border-radius:50%;background:#46d796;box-shadow:0 0 10px rgba(70,215,150,.55)}
.guide{background:#0c0e13;border-bottom-color:#20232d;gap:4px}.guide button{border-radius:7px}.guide button.current{background:#141620}.guide button.current b{box-shadow:0 0 18px rgba(255,66,104,.3)}.guide i{background:linear-gradient(90deg,#2b2e39,#1e2028)}
.panel{background:linear-gradient(180deg,#111219,#0d0e14)}.left-panel,.right-panel{border-color:#252833}.panel-title-row{height:40px;background:#101119;border-color:#242631;padding:0 12px}.panel-title-row strong{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#a1a8b8}.panel-title-row button{border-radius:6px;background:#171922;color:#8f97a9}
.tool-rail{background:#0b0c11;border-color:#22242e;padding:7px 6px;gap:3px}.tool-rail button{position:relative;border-radius:8px;color:#7e879b;transition:.15s ease}.tool-rail button:hover{background:#151720;color:#c9cfda}.tool-rail button.active{background:linear-gradient(180deg,#20222d,#1a1c25);border-color:#333745;color:#fff}.tool-rail button.active:before{content:"";position:absolute;left:-6px;top:12px;bottom:12px;width:2px;border-radius:0 3px 3px 0;background:linear-gradient(#ff4268,#9d62ff);box-shadow:0 0 9px rgba(255,66,104,.5)}.tool-rail button span{font-size:8.5px;letter-spacing:.01em}
.panel-content{padding:13px}.section{padding-bottom:14px;margin-bottom:14px;border-color:#222530}.section h3{text-transform:none;letter-spacing:-.01em;font-size:12px;color:#d8dce6;margin-bottom:9px}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}.section-heading h3{margin:0}.section-kicker,.eyebrow{font-size:8px;letter-spacing:.13em;text-transform:uppercase;color:#737c90;font-w