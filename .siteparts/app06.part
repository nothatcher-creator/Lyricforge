ll></div><span class="recommended">Recommended</span></div>
    <div class="tx-grid"><label class="field"><span>Language</span><select id="txLanguage"><option value="auto" selected>Auto detect</option><option value="en">English</option><option value="fr">French</option><option value="es">Spanish</option><option value="de">German</option><option value="it">Italian</option><option value="pt">Portuguese</option></select></label><label class="field"><span>Quality</span><select id="txQuality"><option value="fast" selected>Fast · smaller model</option><option value="balanced">Balanced · larger model</option><option value="accurate">Accurate · large model</option></select></label></div>
    <div class="tx-notice"><span>↓</span><div><b>Download once</b><small>The AI model downloads the first time you use it and is cached by your browser. Audio stays on this device in built-in mode.</small></div></div>
    ${!hasAudio?'<div class="callout warning"><b>Add a song first</b><span>Import an audio file before running automatic transcription.</span></div>':''}
    <details class="advanced-provider"><summary>Advanced providers</summary><div class="advanced-provider-body"><label class="field"><span>Provider</span><select id="txMode"><option value="builtin" selected>Built-in Whisper (no setup)</option><option value="local">Local Timing Assist (uses pasted lyrics)</option><option value="remote">Whisper-compatible API</option></select></label><div id="txLocal" class="hidden"><label class="field"><span>Lyrics draft</span><textarea id="txDraft" placeholder="Paste lyrics to distribute across the song…">${esc(state.project.lyrics.map(e=>e.text).join('\n'))}</textarea></label></div><div id="txRemote" class="hidden"><label class="field"><span>Endpoint</span><input id="txEndpoint" type="url" placeholder="https://…/audio/transcriptions"></label><label class="field"><span>API key (not saved)</span><input id="txKey" type="password"></label><label class="consent-row"><input type="checkbox" id="txConsent"><span>I understand remote mode uploads my audio to the endpoint above.</span></label></div></div></details>
    <div id="txStatus" class="tx-status hidden"><div class="tx-status-head"><div><span class="status-dot"></span><b id="txMessage">Preparing…</b></div><span id="txPercent">0%</span></div><div class="progress premium"><i id="txBar"></i></div><div class="tx-phase-row"><span data-phase="audio">Audio</span><span data-phase="model">Model</span><span data-phase="transcribe">Listen</span><span data-phase="structure">Structure</span></div><pre id="txPartial"></pre></div>
    <div class="modal-actions"><button type="button" id="txCancel">Cancel</button><button type="button" class="primary hero-action" id="txRun" ${hasAudio?'':'disabled'}><span>✦</span> Transcribe Song</button></div>
  </div>`;
  modal.showModal();
  let controller=null;
  const modeEl=$('#txMode');
  const updateMode=()=>{const mode=modeEl.value;$('#txLocal').classList.toggle('hidden',mode!=='local');$('#txRemote').classList.toggle('hidden',mode!=='remote');const run=$('#txRun');run.disabled=(mode!=='local'&&!runtime.audioBlob);run.innerHTML=mode==='builtin'?'<span>✦</span> Transcribe Song':mode==='local'?'Create Timing Guide':'Use Remote Provider';};
  modeEl.onchange=updateMode;updateMode();
  $('#txCancel').onclick=()=>{controller?.abort();modal.close();};
  const setProgress=(p={})=>{const value=Math.max(0,Math.min(1,Number(p.progress)||0));$('#txStatus').classList.remove('hidden');$('#txBar').style.width=`${Math.round(value*100)}%`;$('#txPercent').textContent=`${Math.round(value*100)}%`;$('#txMessage').textContent=p.message||'Working…';if(p.partial)$('#txPartial').textContent=p.partial;$$('[data-phase]',modalBody).forEach(el=>el.classList.toggle('active',el.dataset.phase===p.phase));};
  $('#txRun').onclick=async()=>{
    const mode=modeEl.value,run=$('#txRun');controller=new AbortController();run.disabled=true;run.classList.add('working');
    try{
      let provider,options={durationUs:projectDuration(),draftText:$('#txDraft')?.value||'',language:$('#txLanguage').value};
      if(mode==='builtin'){
        if(!runtime.audioBlob)throw new Error('Import audio first.');
        const model=$('#txQuality').value==='accurate'?'onnx-community/whisper-small':$('#txQuality').value==='balanced'?'onnx-community/whisper-base':'onnx-community/whisper-tiny';
        provider=runtime.transcriptionProviderFactory?.({model})||new BrowserWhisperProvider({model});
      }else if(mode==='remote'){
        if(!runtime.audioBlob)throw new Error('Import audio first.');if(!$('#txConsent').checked)throw new Error('Upload consent is required for remote transcription.');provider=new WhisperRemoteProvider($('#txEndpoint').value,$('#txKey').value);
      }else provider=new LocalTimingAssistProvider();
      const events=await provider.transcribe(runtime.audioBlob,options,setProgress,controller.signal);
      const normalized=inferSections(events);state.commit(p=>{p.lyrics=normalized;p.instrumentalSections=instrumentalGaps(normalized);});
      setProgress({phase:'done',progress:1,message:`${events.length} editable lyric lines ready`,partial:normalized.map(e=>e.text).join('\n')});
      await new Promise(r=>setTimeout(r,350));modal.close();leftTab='lyrics';renderLeft();toast(`Generated ${events.length} editable lyric events`,'good');
    }catch(err){if(err?.name==='AbortError'){toast('Transcription cancelled');}else{setProgress({progress:0,message:err.message||'Transcription failed'});toast(err.message||'Transcription failed','bad');}}
    finally{run.disabled=false;run.classList.remove('working');controller=null;}
  };
}
function showExportModal(){const caps=videoCapabilities(),s=state.project.exportSettings,dur=projectDuration()/1e6,est=estimateOutputBytes(dur,s.videoBitrate,s.audioBitrate);modalBody.innerHTML=`<div class="modal-card"><h2>Export</h2><p class="subtle">Video is rendered from a separate composition-resolution canvas using the same renderer as preview. Codec availability depends on this browser.</p><div class="two-col"><label class="field"><span>Format</span><select id="exFormat"><option value="webm">WebM</option><option value="mp4" ${caps.mp4?'':'disabled'}>MP4 / H.264 ${caps.mp4?'':'(unsupported here)'}</option></select></label><label class="field"><span>Resolution</span><select id="exRes"><option>720p</option><option selected>1080p</option><option>1440p</option><option>4k</option></select></label><label class="field"><span>FPS</span><select id="exFps"><option>24</option><option selected>30</option><option>60</option></select></label><label class="field"><span>Video bitrate (Mbps)</span><input id="exVb" type="number" value="8" min="1" max="80"></label></div><p class="subtle">Estimated size at current duration: <b id="exEstimate">${bytes(est)}</b>. WebM: ${caps.webm?'supported':'not supported'} · MP4: ${caps.mp4?'supported':'not supported'} · WebCodecs: ${caps.webCodecs?'available':'unavailable'}.</p><div id="exProgress" class="hidden"><div class="progress"><i id="exBar"></i></div><p class="subtle" id="exMsg">Rendering…</p></div><div class="section"><h3>Video / audio</h3><div class="row"><button type="button" class="primary" id="exVideo">Export video</button><button type="button" id="exAudio" ${runtime.audioBlob?'':'disabled'}>Audio only</button></div></div><div class="section"><h3>Lyrics / project</h3><div class="row" style="flex-wrap:wrap"><button type="button" data-ex-sub="txt">TXT</button><button type="button" data-ex-sub="lrc">LRC</button><button type="button" data-ex-sub="srt">SRT</button><button type="button" data-ex-sub="vtt">VTT</button><button type="button" id="exProject">Project file</button></div></div><div class="modal-actions"><button value="cancel">Close</button></div></div>`;modal.showModal();const update=()=>{$('#exEstimate').textContent=bytes(estimateOutputBytes(dur,Number($('#exVb').value)*1e6,s.audioBitrate));};$('#exVb').oninput=update;$$('[data-ex-sub]',modalBody).forEach(b=>b.onclick=()=>downloadBlo