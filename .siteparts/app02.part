 class="field"><span>Gradient end</span><input type="color" value="${s.gradientEnd||s.activeColor||s.color}" data-style="${scope}:gradientEnd"></label></div><div class="three-col"><label class="field"><span>Stroke</span><input type="number" min="0" max="20" value="${s.strokeWidth}" data-style="${scope}:strokeWidth"></label><label class="field"><span>Shadow</span><input type="number" min="0" max="80" value="${s.shadowBlur||0}" data-style="${scope}:shadowBlur"></label><label class="field"><span>Glow</span><input type="number" min="0" max="80" value="${s.glow||0}" data-style="${scope}:glow"></label></div><div class="three-col"><label class="field"><span>Opacity</span><input type="number" min="0" max="1" step=".05" value="${s.opacity??1}" data-style="${scope}:opacity"></label><label class="field"><span>Blur</span><input type="number" min="0" max="40" value="${s.blur||0}" data-style="${scope}:blur"></label><label class="field"><span>Padding</span><input type="number" min="0" max="80" value="${s.padding||0}" data-style="${scope}:padding"></label></div><div class="two-col"><label class="field"><span>Box opacity</span><input type="number" min="0" max="1" step=".05" value="${s.backgroundOpacity||0}" data-style="${scope}:backgroundOpacity"></label><label class="field"><span>Corner radius</span><input type="number" min="0" max="80" value="${s.radius||0}" data-style="${scope}:radius"></label></div><label class="field"><span>Karaoke</span><select data-style="${scope}:karaoke"><option value="word-highlight" ${s.karaoke==='word-highlight'?'selected':''}>Word highlight</option><option value="current-word-scale" ${s.karaoke==='current-word-scale'?'selected':''}>Current word larger</option><option value="progressive-fill" ${s.karaoke==='progressive-fill'?'selected':''}>Progressive fill</option><option value="full-line" ${s.karaoke==='full-line'?'selected':''}>Full line</option></select></label><details><summary>Animation</summary><label class="field"><span>Entrance</span>${anim('entrance')}</label><label class="field"><span>Idle</span>${anim('idle')}</label><label class="field"><span>Exit</span>${anim('exit')}</label><div class="two-col"><label class="field"><span>Entrance ms</span><input type="number" value="${s.entrance?.durationMs||280}" data-style="${scope}:entrance.durationMs"></label><label class="field"><span>Exit ms</span><input type="number" value="${s.exit?.durationMs||240}" data-style="${scope}:exit.durationMs"></label></div></details>`;}
function renderInspector(){const lyric=selectedLyric(),clip=selectedClip();if(lyric){inspector.innerHTML=`<div class="section"><h3>Lyric line</h3><label class="field"><span>Text</span><textarea data-inspect="lyric.text">${esc(lyric.text)}</textarea></label><div class="two-col"><label class="field"><span>Start ms</span><input type="number" step="1" value="${usToMs(lyric.startUs)}" data-inspect="lyric.start"></label><label class="field"><span>End ms</span><input type="number" step="1" value="${usToMs(lyric.endUs)}" data-inspect="lyric.end"></label></div><label class="field"><span>Section</span><select data-inspect="lyric.section">${['intro','verse','pre-chorus','chorus','post-chorus','bridge','breakdown','instrumental','outro','unknown'].map(x=>`<option ${lyric.sectionType===x?'selected':''}>${x}</option>`).join('')}</select></label><div class="row"><button data-inspect-action="split">Split</button><button data-inspect-action="duplicate">Duplicate</button><button data-inspect-action="delete">Delete</button></div></div><div class="section"><h3>Word timing ${lyric.words?.length?`· ${lyric.words.length}`:''}</h3>${lyric.words?.length?`<div class="word-table">${lyric.words.map(w=>`<div class="word-row"><input value="${esc(w.text)}" data-word="${w.id}:text"><input type="number" value="${usToMs(w.startUs)}" data-word="${w.id}:start"><input type="number" value="${usToMs(w.endUs)}" data-word="${w.id}:end"></div>`).join('')}</div>`:'<p class="subtle">Word timing appears here after a provider returns word timestamps. Line timing remains fully editable either way.</p>'}</div><div class="section"><h3>Line style override</h3><button data-inspect-action="use-global">Reset to global style</button></div>`;return;}
  if(clip&&clip.type==='text'){const s={...state.project.titleStyle,...clip.content?.style};inspector.innerHTML=`<div class="section"><h3>Text layer</h3><label class="field"><span>Text</span><textarea data-inspect="clip.text">${esc(clip.content?.text||'')}</textarea></label><div class="two-col"><label class="field"><span>Start ms</span><input type="number" value="${usToMs(clip.startUs)}" data-inspect="clip.start"></label><label class="field"><span>End ms</span><input type="number" value="${usToMs(clip.endUs)}" data-inspect="clip.end"></label></div><p class="subtle">Drag the text directly in the preview to position it.</p></div><div class="section"><h3>Typography</h3>${textStyleFields(s,'clip')}</div><div class="section"><h3>Transform</h3><div class="two-col"><label class="field"><span>X</span><input type="number" step=".01" value="${s.x}" data-style="clip:x"></label><label class="field"><span>Y</span><input type="number" step=".01" value="${s.y}" data-style="clip:y"></label><label class="field"><span>Scale</span><input type="number" step=".05" value="${s.scale}" data-style="clip:scale"></label><label class="field"><span>Rotation</span><input type="number" value="${s.rotation}" data-style="clip:rotation"></label></div><button data-inspect-action="add-keyframe">+ Keyframe at playhead</button></div>`;return;}
  if(clip){const t=clip.transform||{x:.5,y:.5,scale:1,rotation:0};inspector.innerHTML=`<div class="section"><h3>${clip.type==='image'?'Image':'Video'} layer</h3><div class="two-col"><label class="field"><span>Start ms</span><input type="number" value="${usToMs(clip.startUs)}" data-inspect="clip.start"></label><label class="field"><span>End ms</span><input type="number" value="${usToMs(clip.endUs)}" data-inspect="clip.end"></label></div><p class="subtle">Drag the layer directly in preview. Resize and rotate precisely below.</p></div><div class="section"><h3>Transform</h3><div class="two-col"><label class="field"><span>X</span><input data-clip-transform="x" type="number" step=".01" value="${t.x}"></label><label class="field"><span>Y</span><input data-clip-transform="y" type="number" step=".01" value="${t.y}"></label><label class="field"><span>Scale</span><input data-clip-transform="scale" type="number" step=".05" value="${t.scale}"></label><label class="field"><span>Rotation</span><input data-clip-transform="rotation" type="number" value="${t.rotation}"></label></div><label class="field"><span>Opacity</span><input data-clip-prop="opacity" type="range" min="0" max="1" step=".05" value="${clip.opacity??1}"></label><label class="field"><span>Blend mode</span><select data-clip-prop="blendMode">${['source-over','screen','multiply','overlay','lighter'].map(x=>`<option ${clip.blendMode===x?'selected':''}>${x}</option>`).join('')}</select></label><button data-inspect-action="add-keyframe">+ Keyframe at playhead</button></div>`;return;}
  const c=state.project.composition,s=state.project.lyricStyle;inspector.innerHTML=`<div class="section"><h3>Composition</h3><label class="field"><span>Aspect ratio</span><select data-compose="aspect">${['16:9','9:16','1:1','4:5','21:9'].map(x=>`<option ${c.aspect===x?'selected':''}>${x}</option>`).join('')}</select></label><label class="field"><span>Resolution</span><select data-compose="resolution"><option>720p</option><option selected>1080p</option><option>1440p</option><option>4k</option></select></label><label class="field"><span>Frame rate</span><select data-compose="fps">${[24,30,60].map(x=>`<option ${c.fps===x?'selected':''}>${x}</option>`).join('')}</select></label></div><div class="section"><h3>Global lyric style</h3>${textStyleFields(s,'global')}</div>`;}

function renderTimeline(){const zoom=Number($('#timelineZoom').value||1), ppu=pxPerUs(),duration=projectDuration(), width=Math.max(1200,dura