eight:36px;background:#f4f5f8;color:#0b0c10;box-shadow:0 5px 18px rgba(0,0,0,.28)}.transport .play:hover{background:#fff}.transport time{color:#d7dbe3;font-size:10px;letter-spacing:.03em}.transport select{background:#14161e}
.timeline-panel{background:#0b0c11}.timeline-tools{background:#0f1117;border-color:#242732;padding-inline:9px}.timeline-shell{border-top:1px solid #161821}.track-headers{background:#0d0f14;border-color:#232631}.track-head{border-color:#20232b}.track-head .name{color:#9aa2b2;font-weight:650}.timeline-scroll{background:#0a0c10}.ruler{background:#0d0f14;border-color:#252832}.track-row{border-color:#1d2028;background:linear-gradient(90deg,rgba(255,255,255,.009),transparent 70%)}.clip{border-radius:5px;box-shadow:0 3px 10px rgba(0,0,0,.16)}.clip.lyric{background:linear-gradient(90deg,#4b1d31,#322039);border-color:#6d3b56}.playhead{box-shadow:0 0 8px rgba(255,66,104,.35)}
.modal-card{width:min(700px,88vw);border-radius:16px;background:linear-gradient(180deg,#151720,#0f1118);border-color:#343844;box-shadow:0 32px 100px rgba(0,0,0,.58);padding:20px}.modal-card h2{font-size:19px;letter-spacing:-.025em}.modal-hero{display:grid;grid-template-columns:46px 1fr auto;gap:12px;align-items:center;margin-bottom:16px}.modal-hero h2{margin:2px 0 3px}.modal-hero p{margin:0;color:#8d95a6;font-size:10.5px}.modal-icon{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;font-size:18px}.ai-glow{background:linear-gradient(145deg,#ff4166,#8b5fff);box-shadow:0 9px 34px rgba(164,72,220,.26),inset 0 0 0 1px rgba(255,255,255,.12)}.tx-provider-card{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 12px;border:1px solid #3b3447;border-radius:10px;background:linear-gradient(120deg,rgba(255,66,104,.07),rgba(141,105,255,.06));margin-bottom:12px}.tx-provider-card b,.tx-provider-card small{display:block}.tx-provider-card b{font-size:11px}.tx-provider-card small{font-size:9px;color:#8f97a8;margin-top:2px}.recommended{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#d9ccff;background:#2b2440;border:1px solid #443764;padding:4px 6px;border-radius:999px}.tx-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.tx-notice{display:grid;grid-template-columns:28px 1fr;gap:8px;align-items:center;border:1px solid #2a2f38;background:#10151a;border-radius:9px;padding:9px 10px;margin:3px 0 11px}.tx-notice>span{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:#171e24;color:#75dcae}.tx-notice b,.tx-notice small{display:block}.tx-notice b{font-size:9px;color:#c4cbd6}.tx-notice small{font-size:8.5px;color:#7f8999;margin-top:2px;line-height:1.35}.advanced-provider{background:#0d0f15;border-color:#282c36;padding:0;margin:7px 0}.advanced-provider summary{padding:9px 10px;margin:0;color:#8f97a8}.advanced-provider[open] summary{border-bottom:1px solid #242731}.advanced-provider-body{padding:10px}.consent-row{display:flex;align-items:flex-start;gap:7px;color:#9aa2b2;font-size:9px;line-height:1.4}.consent-row input{margin-top:2px}.callout{border-radius:9px;padding:9px 10px;margin-bottom:10px;display:grid;gap:2px}.callout.warning{border:1px solid rgba(255,184,74,.3);background:rgba(255,184,74,.07);color:#ffc46b}.callout b{font-size:9px}.callout span{font-size:8.5px;color:#a79b87}.tx-status{margin-top:11px;border:1px solid #2a2e38;background:#0d0f14;border-radius:10px;padding:10px}.tx-status-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;font-size:9px;color:#a8b0c0}.tx-status-head>div{display:flex;align-items:center;gap:6px}.status-dot{width:6px;height:6px;border-radius:50%;background:#8d69ff;box-shadow:0 0 10px #8d69ff}.progress.premium{height:6px;background:#1e2028}.progress.premium i{background:linear-gradient(90deg,#ff4268,#9b65ff,#57d8ff);transition:width .25s ease}.tx-phase-row{display:flex;justify-content:space-between;margin-top:7px}.tx-phase-row span{font-size:7.5px;text-transform:uppercase;letter-spacing:.08em;col