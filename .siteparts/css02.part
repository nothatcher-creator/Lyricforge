px;color:#abb2c3}
.transport{display:flex;align-items:center;justify-content:center;gap:25px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#0c0e14;padding:0 12px}.transport-left,.transport-right{display:flex;align-items:center;gap:5px}.transport .play{border-radius:50%;width:34px;height:34px;padding:0;background:#f1f3f7;color:#08090d;font-weight:900}.transport time{font-variant-numeric:tabular-nums;font-size:11px;color:#c8cedb;min-width:145px;text-align:center}.transport-right label{display:flex;align-items:center;gap:5px;font-size:10px;color:#939bad}.transport select{width:auto;padding:4px}.transport input[type=range]{width:90px}
.timeline-panel{min-height:0;background:#0b0d13;display:grid;grid-template-rows:37px 1fr}.timeline-tools{display:flex;align-items:center;justify-content:space-between;padding:0 8px;border-bottom:1px solid var(--line)}.timeline-tools>div{display:flex;align-items:center;gap:5px}.timeline-tools button{font-size:10px;padding:5px 7px}.snap-controls label{font-size:10px;color:#9da5b6;display:flex;align-items:center;gap:4px}.snap-controls select{padding:3px 5px;width:auto}.snap-controls input[type=range]{width:100px}.timeline-shell{display:grid;grid-template-columns:170px 1fr;min-height:0;position:relative}.track-headers{overflow:hidden;background:#0d0f16;border-right:1px solid var(--line);padding-top:24px}.track-head{height:var(--track-h);border-bottom:1px solid #202432;display:flex;align-items:center;gap:5px;padding:0 6px}.track-head .name{font-size:10px;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.track-head button{font-size:9px;padding:2px 4px;border:0;background:transparent;color:#8991a4}.track-head button.on{color:#fff;background:#252a38}.timeline-scroll{overflow:auto;min-height:0}.timeline-content{position:relative;min-width:1200px}.ruler{height:24px;position:sticky;top:0;z-index:7;background:#0b0d13;border-bottom:1px solid var(--line)}.tick{position:absolute;top:0;height:24px;border-left:1px solid #2c3140;padding-left:3px;font-size:8px;color:#7f879b}.tracks{position:relative}.track-row{height:var(--track-h);border-bottom:1px solid #202432;position:relative;background:linear-gradient(90deg,rgba(255,255,255,.012),transparent)}.track-row.locked{background:#11131a}.waveform{position:absolute;inset:4px 0;opacity:.8}.wave-bar{position:absolute;top:50%;width:1px;background:#5e77ff}.beat-marker,.marker-line{position:absolute;top:0;bottom:0;width:1px;pointer-events:none}.beat-marker{background:rgba(77,228,255,.2)}.marker-line{background:rgba(255,184,74,.65);z-index:3}.clip{position:absolute;top:5px;height:31px;border:1px solid #545c76;border-radius:5px;background:#252c42;overflow:hidden;cursor:grab;user-select:none;touch-action:none}.clip:active{cursor:grabbing}.clip.lyric{background:linear-gradient(90deg,#421a2b,#2c213d);border-color:#7e3b5d}.clip.text{background:#21344a;border-color:#37648f}.clip.selected{box-shadow:0 0 0 2px var(--accent) inset;border-color:#ff7690}.clip .label{font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:7px 8px;color:#edf0f7;pointer-events:none}.clip .handle{position:absolute;top:0;bottom:0;width:6px;cursor:ew-resize;background:rgba(255,255,255,.08)}.clip .handle.left{left:0}.clip .handle.right{right:0}.key-dot{position:absolute;top:25px;width:5px;height:5px;background:#ffd166;transform:rotate(45deg);z-index:2}.playhead{position:absolute;top:0;bottom:0;width:1px;background:#ff365c;z-index:8;pointer-events:none}.playhead:before{content:"";position:absolute;top:0;left:-5px;border-left:5px solid transparent;border-right:5px solid transparent;border-top:8px solid #ff365c}.playhead span{display:none}.selection-box{display:none;position:absolute;border:1px solid #7b84ff;background:rgba(91,100,255,.08);z-index:9;pointer-events:none}
