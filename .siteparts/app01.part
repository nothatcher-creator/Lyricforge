per row…"></textarea><div class="row"><button data-left="add-pasted">Create lyric events</button><button data-left="add-line">Add line</button></div></div><div class="section"><div class="section-heading"><h3>Manual synchronization</h3><span class="section-kicker">Tap to time</span></div><div class="three-col sync-grid"><button data-left="set-start">Set Start</button><button data-left="set-end">Set End</button><button data-left="snap-playhead">Snap</button><button data-left="prev-line">Prev</button><button class="primary" data-left="tap-sync">Tap Sync</button><button data-left="next-line">Next</button><button data-left="nudge-earlier">− Nudge</button><button data-left="nudge-later">+ Nudge</button><button data-left="merge">Merge</button></div><p class="subtle">Start playback, select the first line, then press Tap Sync whenever the next lyric begins.</p></div><div class="section"><div class="row lyric-search-row"><input id="lyricSearch" type="text" value="${esc(searchLyrics)}" placeholder="Search lyrics…"><button data-left="low-confidence" title="Show confidence warnings">⚠</button></div><div class="lyric-list">${lines.map(e=>`<div class="lyric-row ${state.selected.lyrics.has(e.id)?'selected':''}" data-lyric-id="${e.id}"><time>${formatClock(e.startUs,false)}</time><input data-line-text="${e.id}" value="${esc(e.text)}"><span class="confidence ${e.confidence<.75?'low':''}">${Math.round((e.confidence??1)*100)}%</span></div>`).join('')||'<div class="empty-state compact"><span>♪</span><b>No lyrics yet</b><small>Auto-detect them, paste text, or add a line manually.</small></div>'}</div></div>`;}
function textPanel(){return `<div class="section"><h3>Text layers</h3><button class="primary" style="width:100%" data-left="add-title">+ Add title / text</button><p class="subtle">Additional text is independent from lyrics and can be timed, dragged and keyframed.</p></div><div class="section"><h3>Global lyric typography</h3>${textStyleFields(state.project.lyricStyle,'global')}</div>`;}
function presetsPanel(){return `<div class="section"><h3>Genre starting points</h3><div class="preset-grid">${PRESETS.map(p=>`<div class="preset-card" data-preset="${p.id}" style="--p-bg:${p.background};--p-accent:${p.accent}"><b>${p.name}</b><span>${p.entrance} · ${p.karaoke}</span></div>`).join('')}</div></div><div class="section"><h3>Custom presets</h3><button data-left="save-preset">Save current style</button><div class="stack" style="margin-top:7px">${(state.project.customPresets||[]).map((p,i)=>`<button data-custom-preset="${i}">${esc(p.name)}</button>`).join('')||'<p class="subtle">Save your current typography, background and visualizer as a reusable project preset.</p>'}</div></div>`;}
function effectsPanel(){const v=state.project.visualizer,b=state.project.background;return `<div class="section"><h3>Music visualizer</h3><label class="field"><span>Type</span><select data-project="visualizer.type"><option value="bars" ${v.type==='bars'?'selected':''}>Audio Bars</option><option value="spectrum" ${v.type==='spectrum'?'selected':''}>Spectrum</option><option value="circular" ${v.type==='circular'?'selected':''}>Circular Spectrum</option><option value="pulse" ${v.type==='pulse'?'selected':''}>Pulsing Glow</option></select></label><label class="row"><input type="checkbox" data-project="visualizer.enabled" ${v.enabled?'checked':''}> Enable visualizer</label><label class="field"><span>Sensitivity</span><input type="range" min=".2" max="3" step=".1" value="${v.sensitivity}" data-project="visualizer.sensitivity"></label><label class="field"><span>Opacity</span><input type="range" min="0" max="1" step=".05" value="${v.opacity}" data-project="visualizer.opacity"></label><label class="field"><span>Color</span><input type="color" value="${v.color}" data-project="visualizer.color"></label></div><div class="section"><h3>Background treatment</h3><label class="field"><span>Fit</span><select data-project="background.fit"><option ${b.fit==='cover'?'selected':''}>cover</option><option ${b.fit==='contain'?'selected':''}>contain</option><option ${b.fit==='stretch'?'selected':''}>stretch</option></select></label>${['blur','brightness','contrast','saturation','hue','vignette'].map(k=>`<label class="field"><span>${k[0].toUpperCase()+k.slice(1)}</span><input type="range" data-project="background.${k}" value="${b[k]??0}" min="${k==='hue'?-180:0}" max="${k==='blur'?30:k==='hue'?180:2}" step="${k==='blur'||k==='hue'?1:.05}"></label>`).join('')}</div>`;}
function elementsPanel(){return `<div class="section"><h3>Markers</h3><button data-left="marker">+ Marker at playhead</button><div class="stack" style="margin-top:8px">${state.project.markers.map(m=>`<div class="asset-card"><span class="asset-icon">◆</span><div><b>${esc(m.label)}</b><small>${formatClock(m.timeUs)}</small></div></div>`).join('')||'<p class="subtle">Markers help with snapping and structure.</p>'}</div></div><div class="section"><h3>Layer controls</h3><p class="subtle">Use the timeline track eye/lock/mute controls to manage layers. Additional text, images, backgrounds, overlays and effects remain separate objects.</p></div>`;}
function textStyleFields(s,scope){const anim=(slot)=>`<select data-style="${scope}:${slot}.name">${ANIMATIONS.map(x=>`<option value="${x}" ${s[slot]?.name===x?'selected':''}>${x}</option>`).join('')}</select>`;return `<label class="field"><span>Font</span><select data-style="${scope}:fontFamily"><option value="Inter, system-ui, sans-serif" ${String(s.fontFamily).startsWith('Inter')?'selected':''}>Inter / System</option><option value="Arial Black, sans-serif" ${String(s.fontFamily).startsWith('Arial Black')?'selected':''}>Arial Black</option><option value="Impact, sans-serif" ${String(s.fontFamily).startsWith('Impact')?'selected':''}>Impact</option>${state.project.fonts.map(f=>`<option value="${esc(f.family)}" ${s.fontFamily===f.family?'selected':''}>${esc(f.family)} · Project Font</option>`).join('')}</select></label><div class="two-col"><label class="field"><span>Size</span><input type="number" value="${s.fontSize}" data-style="${scope}:fontSize"></label><label class="field"><span>Weight</span><select data-style="${scope}:fontWeight">${[400,600,800,900].map(w=>`<option value="${w}" ${Number(s.fontWeight)===w?'selected':''}>${w}</option>`).join('')}</select></label></div><div class="two-col"><label class="row"><input type="checkbox" ${s.italic?'checked':''} data-style="${scope}:italic"> Italic</label><label class="row"><input type="checkbox" ${s.underline?'checked':''} data-style="${scope}:underline"> Underline</label></div><label class="field"><span>Capitalization</span><select data-style="${scope}:textTransform"><option value="none" ${s.textTransform==='none'?'selected':''}>As typed</option><option value="uppercase" ${s.textTransform==='uppercase'?'selected':''}>UPPERCASE</option><option value="lowercase" ${s.textTransform==='lowercase'?'selected':''}>lowercase</option></select></label><div class="three-col"><label class="field"><span>Letter</span><input type="number" step=".5" value="${s.letterSpacing||0}" data-style="${scope}:letterSpacing"></label><label class="field"><span>Word</span><input type="number" step=".5" value="${s.wordSpacing||0}" data-style="${scope}:wordSpacing"></label><label class="field"><span>Line</span><input type="number" step=".05" value="${s.lineHeight||1.1}" data-style="${scope}:lineHeight"></label></div><div class="two-col"><label class="field"><span>Text color</span><input type="color" value="${s.color}" data-style="${scope}:color"></label><label class="field"><span>Active color</span><input type="color" value="${s.activeColor||s.color}" data-style="${scope}:activeColor"></label></div><label class="row"><input type="checkbox" ${s.gradientEnabled?'checked':''} data-style="${scope}:gradientEnabled"> Gradient text</label><div class="two-col"><label class="field"><span>Gradient start</span><input type="color" value="${s.gradientStart||s.color}" data-style="${scope}:gradientStart"></label><label