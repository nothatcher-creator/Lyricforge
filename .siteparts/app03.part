tion*ppu);timelineContent.style.width=`${width}px`;const ruler=$('#ruler');const seconds=duration/1e6;const tickSec=zoom>=3?1:zoom>=1?5:10;let ticks='';for(let s=0;s<=seconds;s+=tickSec)ticks+=`<span class="tick" style="left:${xForUs(s*1e6)}px">${formatClock(s*1e6,false)}</span>`;ruler.innerHTML=ticks;
  const headers=$('#trackHeaders'),tracks=$('#tracks');headers.innerHTML='';tracks.innerHTML='';for(const t of [...state.project.tracks].sort((a,b)=>a.order-b.order)){headers.insertAdjacentHTML('beforeend',`<div class="track-head" data-track="${t.id}"><button data-track-action="visible" class="${t.visible?'on':''}" title="Visibility">◉</button><button data-track-action="locked" class="${t.locked?'on':''}" title="Lock">⌑</button>${t.type==='audio'?`<button data-track-action="muted" class="${t.muted?'on':''}" title="Mute">M</button>`:''}<span class="name">${esc(t.name)}</span><button data-track-action="up" title="Move layer up">↑</button><button data-track-action="down" title="Move layer down">↓</button></div>`);const row=document.createElement('div');row.className=`track-row ${t.locked?'locked':''}`;row.dataset.track=t.id;tracks.append(row);if(t.type==='audio')drawWaveform(row,width);if(t.type==='lyrics'){for(const e of state.project.lyrics)row.append(makeTimelineClip(e,'lyric'));}for(const c of state.project.clips.filter(c=>c.trackId===t.id))row.append(makeTimelineClip(c,c.type));}
  for(const beat of state.project.beats||[]){const d=document.createElement('div');d.className='beat-marker';d.style.left=`${xForUs(typeof beat==='number'?beat:beat.timeUs)}px`;d.style.top='24px';d.style.bottom='0';timelineContent.append(d);}for(const m of state.project.markers||[]){const d=document.createElement('div');d.className='marker-line';d.style.left=`${xForUs(m.timeUs)}px`;d.style.top='24px';d.style.bottom='0';d.title=m.label;timelineContent.append(d);}updatePlayhead();}
function drawWaveform(row,width){if(!runtime.peaks?.length)return;const box=document.createElement('div');box.className='waveform';const frag=document.createDocumentFragment();const step=width/runtime.peaks.length;runtime.peaks.forEach((p,i)=>{const b=document.createElement('i');b.className='wave-bar';b.style.left=`${i*step}px`;const amp=Math.max(Math.abs(p.min),Math.abs(p.max));b.style.height=`${Math.max(1,amp*30)}px`;b.style.transform='translateY(-50%)';frag.append(b);});box.append(frag);row.append(box);}
function makeTimelineClip(o,kind){const d=document.createElement('div');d.className=`clip ${kind} ${(kind==='lyric'?state.selected.lyrics:state.selected.clips).has(o.id)?'selected':''}`;d.dataset.kind=kind==='lyric'?'lyric':'clip';d.dataset.id=o.id;d.style.left=`${xForUs(o.startUs)}px`;d.style.width=`${Math.max(8,xForUs(o.endUs-o.startUs))}px`;d.innerHTML=`<span class="handle left" data-edge="left"></span><span class="label">${esc(kind==='lyric'?o.text:o.content?.text||kind)}</span><span class="handle right" data-edge="right"></span>`;for(const k of o.keyframes||[]){const dot=document.createElement('i');dot.className='key-dot';dot.style.left=`${xForUs(k.timeUs)}px`;d.append(dot);}return d;}
function updatePlayhead(){const x=xForUs(state.playheadUs);$('#playhead').style.left=`${x}px`;const viewLeft=timelineScroll.scrollLeft,viewRight=viewLeft+timelineScroll.clientWidth;if(x<viewLeft||x>viewRight){} }
function updateTime(){$('#timeDisplay').textContent=`${formatClock(state.playheadUs)} / ${formatClock(projectDuration())}`;}

function renderFrame(){const freq=audio.frequencyData();for(const [id,el] of runtime.assetElements){if(el instanceof HTMLVideoElement){const t=(state.playheadUs/1e6)%(el.duration||1);if(Number.isFinite(t)&&Math.abs((el.currentTime||0)-t)>.25)try{el.currentTime=t;}catch{}}}renderComposition(ctx,state.project,state.playheadUs,{assetElements:runtime.assetElements,frequencyData:freq},{guides:runtime.guides});}
function playbackLoop(){cancelAnimationFrame(renderRAF);const tick=()=>{if(audio.playing){state.playheadUs=Math.min(projectDuration(),audio.currentTimeUs());if(runtime.loopEnabled&&runtime.loopRange&&state.playheadUs>=runtime.loopRange[1]){state.playheadUs=runtime.loopRange[0];audio.seekUs(state.playheadUs);}updatePlayhead();updateTime();renderFrame();if(!runtime.loopEnabled&&state.playheadUs>=projectDuration())audio.stop();}renderRAF=requestAnimationFrame(tick);};tick();}

async function importFiles(files){for(const file of files){try{await importFile(file);}catch(e){console.error(e);toast(`${file.name}: ${e.message}`,'bad');}}}
async function importFile(file){const e=ext(file.name),type=file.type;
  if(['txt','lrc','srt','vtt','ass','ssa'].includes(e)){const events=parseLyrics(await file.text(),e);state.addLyrics(events);toast(`Imported ${events.length} lyric lines`,'good');leftTab='lyrics';return;}
  if(e==='lyricforge'){const data=await restoreProjectBundle(await file.text(),(id,blob,meta)=>putAsset(id,blob,meta));await loadIntoEditor(data);toast('Portable project bundle imported','good');return;}if(e==='json'){const data=JSON.parse(await file.text());if(data.schemaVersion){await loadIntoEditor(data);toast('Project imported','good');return;}}
  if(['ttf','otf','woff','woff2'].includes(e)||type.startsWith('font/')){const id=uid('font'),family=file.name.replace(/\.[^.]+$/,'');await putAsset(id,file,{name:file.name,type:'font'});const url=URL.createObjectURL(file);const face=new FontFace(family,`url(${url})`);await face.load();document.fonts.add(face);runtime.assetUrls.set(id,url);state.commit(p=>{p.assets.push({id,name:file.name,type:'font',mime:file.type,size:file.size});p.fonts.push({id,family,name:file.name});});toast(`Project font “${family}” added`,'good');return;}
  let assetType=type.startsWith('audio/')?'audio':type.startsWith('image/')?'image':type.startsWith('video/')?'video':null;if(!assetType)throw new Error('Unsupported file type');const id=uid(assetType);await putAsset(id,file,{name:file.name,type:assetType,mime:file.type,size:file.size});const meta={id,name:file.name,type:assetType,mime:file.type,size:file.size,role:null};
  if(assetType==='audio'){runtime.audioBlob=file;const analysis=await audio.load(file);runtime.peaks=analysis.peaks;runtime.bpm=analysis.beat.bpm;state.commit(p=>{p.assets=p.assets.filter(a=>a.id!==id);meta.role='master-audio';p.assets.push(meta);p.audioMasterAssetId=id;p.durationUs=analysis.durationUs;p.beats=analysis.beat.beatsUs;});toast(`Audio ready · ${analysis.beat.bpm||'—'} BPM`,'good');}
  else{const url=URL.createObjectURL(file);runtime.assetUrls.set(id,url);let el;if(assetType==='image'){el=new Image();el.src=url;await el.decode();}else{el=document.createElement('video');el.src=url;el.muted=true;el.loop=true;el.playsInline=true;await new Promise((res,rej)=>{el.onloadedmetadata=res;el.onerror=()=>rej(new Error('Video could not be decoded by this browser.'));});}runtime.assetElements.set(id,el);state.commit(p=>{if(!p.assets.some(a=>a.id===id)){meta.role=p.assets.some(a=>a.role==='background')?null:'background';p.assets.push(meta);}if(meta.role==='background')p.background.type=assetType;});toast(`${assetType} imported`,'good');}
}
async function restoreAssets(){for(const url of runtime.assetUrls.values())URL.revokeObjectURL(url);runtime.assetUrls.clear();runtime.assetElements.clear();runtime.audioBlob=null;runtime.peaks=[];for(const a of state.project.assets){const rec=await getAsset(a.id).catch(()=>null);if(!rec?.blob)continue;const blob=rec.blob;if(a.type==='audio'&&a.id===state.project.audioMasterAssetId){runtime.audioBlob=blob;try{const analysis=await audio.load(blob);runtime.peaks=analysis.peaks;runtime.bpm=analysis.beat.bpm;}catch{}}else if(a.type==='image'){const u=URL.createObjectURL(blob);runtime.assetUrls.set(a.id,u);const im=new Image();im.src=u;try{await im.decode();runtime.assetElements.set(a.id,im);}catch{}}else if(a.type==='video'){const u=URL.createObjectURL(blob);runtime.assetUrls.set(a.id,u);const v=document.createElement('video');v.src=u;v.muted=true;v.loop=true;v.playsInline=true;await new Promise(r=>{v.onloaded