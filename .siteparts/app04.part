metadata=r;v.onerror=r;});runtime.assetElements.set(a.id,v);}else if(a.type==='font'){const family=state.project.fonts.find(f=>f.id===a.id)?.family||a.name.replace(/\.[^.]+$/,'');const u=URL.createObjectURL(blob);runtime.assetUrls.set(a.id,u);try{const face=new FontFace(family,`url(${u})`);await face.load();document.fonts.add(face);}catch{}}}renderFrame();renderTimeline();}
async function loadIntoEditor(project){audio.stop();state.replace(project,{dirty:false});await restoreAssets();}

function setDeep(obj,path,value){const parts=path.split('.');let cur=obj;for(let i=0;i<parts.length-1;i++)cur=cur[parts[i]];cur[parts.at(-1)]=value;}
function typedValue(input){if(input.type==='checkbox')return input.checked;if(input.type==='number'||input.type==='range')return Number(input.value);return input.value;}

left.addEventListener('click',async e=>{const b=e.target.closest('[data-left]');if(b){const a=b.dataset.left;if(a==='import')$('#fileInput').click();if(a==='import-project'){const inp=document.createElement('input');inp.type='file';inp.accept='.lyricforge,.json';inp.onchange=()=>importFiles(inp.files);inp.click();}if(a==='export-project'){const bundle=await createProjectBundle(state.project,getAsset);downloadBlob(bundle,`${state.project.name}.lyricforge`);}if(a==='add-pasted'){const text=$('#lyricPaste')?.value||'';if(text.trim())state.addLyrics(parseLyrics(text,'txt'));}if(a==='add-line')state.addLyric();if(a==='auto-detect')showTranscriptionModal();if(a==='add-title')state.addTextClip('Song Title');if(a==='marker')state.addMarker();if(a==='set-start'){const l=selectedLyric();if(l)state.updateLyric(l.id,{startUs:state.playheadUs});}if(a==='set-end'){const l=selectedLyric();if(l)state.updateLyric(l.id,{endUs:Math.max(l.startUs+10_000,state.playheadUs)});}if(a==='snap-playhead'){const l=selectedLyric();if(l)state.updateLyric(l.id,{startUs:state.playheadUs});}if(a==='nudge-earlier')state.nudgeSelected(-Number($('#nudgeAmount').value||50000));if(a==='nudge-later')state.nudgeSelected(Number($('#nudgeAmount').value||50000));if(a==='merge')state.mergeSelected();if(a==='prev-line'||a==='next-line'){const sorted=[...state.project.lyrics].sort((x,y)=>x.startUs-y.startUs),cur=selectedLyric(),i=Math.max(0,sorted.findIndex(x=>x.id===cur?.id)),n=a==='prev-line'?Math.max(0,i-1):Math.min(sorted.length-1,i+1);if(sorted[n])state.selectLyric(sorted[n].id);}if(a==='tap-sync')manualTapSync();if(a==='save-preset'){const name=prompt('Preset name','My LyricForge Style');if(name)state.commit(p=>p.customPresets.push({name,lyricStyle:structuredClone(p.lyricStyle),background:structuredClone(p.background),visualizer:structuredClone(p.visualizer)}));}if(a==='add-media-layer'){const id=b.dataset.id,asset=state.project.assets.find(x=>x.id===id);if(asset){const track=state.project.tracks.find(t=>t.type===(asset.type==='image'?'images':'overlays'))||state.project.tracks.find(t=>t.type==='overlays');const clip=createClip(asset.type,track.id,state.playheadUs,Math.min(projectDuration(),state.playheadUs+5_000_000),{assetId:id});state.commit(p=>p.clips.push(clip));state.selectClip(clip.id);}}if(a==='set-background'){const id=b.dataset.id;state.commit(p=>{p.assets.forEach(x=>{if(x.role==='background')x.role=null;});const asset=p.assets.find(x=>x.id===id);if(asset){asset.role='background';p.background.type=asset.type;}});}if(a==='low-confidence'){searchLyrics='';renderLeft();$$('.lyric-row',left).forEach(r=>{const id=r.dataset.lyricId,e=state.project.lyrics.find(x=>x.id===id);r.classList.toggle('hidden',(e?.confidence??1)>=.75);});}}const row=e.target.closest('[data-lyric-id]');if(row&&!e.target.matches('input'))state.selectLyric(row.dataset.lyricId,e.ctrlKey||e.metaKey);const preset=e.target.closest('[data-preset]');if(preset){state.commit(p=>{const n=applyPreset(p,preset.dataset.preset);Object.assign(p,n);});toast(`${PRESETS.find(p=>p.id===preset.dataset.preset)?.name} preset applied`,'good');}const cp=e.target.closest('[data-custom-preset]');if(cp){const p=state.project.customPresets[Number(cp.dataset.customPreset)];if(p)state.commit(x=>{x.lyricStyle=structuredClone(p.lyricStyle);x.background=structuredClone(p.background);x.visualizer=structuredClone(p.visualizer);});}});
left.addEventListener('change',e=>{if(e.target.matches('[data-line-text]'))state.updateLyric(e.target.dataset.lineText,{text:e.target.value});if(e.target.id==='lyricSearch'){searchLyrics=e.target.value;renderLeft();}const path=e.target.dataset.project;if(path)state.commit(p=>setDeep(p,path,typedValue(e.target)));const style=e.target.dataset.style;if(style)applyStyleChange(style,typedValue(e.target));});
left.addEventListener('input',e=>{if(e.target.dataset.project&&e.target.type==='range')state.commit(p=>setDeep(p,e.target.dataset.project,typedValue(e.target)),{history:false});});

inspector.addEventListener('change',e=>{const l=selectedLyric(),c=selectedClip(),k=e.target.dataset.inspect;if(k&&l){if(k==='lyric.text')state.updateLyric(l.id,{text:e.target.value});if(k==='lyric.start')state.updateLyric(l.id,{startUs:msToUs(e.target.value)});if(k==='lyric.end')state.updateLyric(l.id,{endUs:msToUs(e.target.value)});if(k==='lyric.section')state.updateLyric(l.id,{sectionType:e.target.value});}if(k&&c){if(k==='clip.text')state.commit(p=>{p.clips.find(x=>x.id===c.id).content.text=e.target.value;});if(k==='clip.start')state.commit(p=>{p.clips.find(x=>x.id===c.id).startUs=msToUs(e.target.value);});if(k==='clip.end')state.commit(p=>{p.clips.find(x=>x.id===c.id).endUs=msToUs(e.target.value);});}if(e.target.dataset.word&&l){const [wid,prop]=e.target.dataset.word.split(':');state.commit(p=>{const w=p.lyrics.find(x=>x.id===l.id)?.words.find(x=>x.id===wid);if(w)w[prop==='text'?'text':prop==='start'?'startUs':'endUs']=prop==='text'?e.target.value:msToUs(e.target.value);});}if(e.target.dataset.style)applyStyleChange(e.target.dataset.style,typedValue(e.target));if(e.target.dataset.clipTransform&&c){state.commit(p=>{p.clips.find(x=>x.id===c.id).transform[e.target.dataset.clipTransform]=Number(e.target.value);});}if(e.target.dataset.clipProp&&c){state.commit(p=>{p.clips.find(x=>x.id===c.id)[e.target.dataset.clipProp]=typedValue(e.target);});}if(e.target.dataset.compose){if(e.target.dataset.compose==='aspect'){const res=resolveResolution('1080p',e.target.value);state.commit(p=>{p.composition.aspect=e.target.value;p.composition.width=res.width;p.composition.height=res.height;});}if(e.target.dataset.compose==='resolution'){const res=resolveResolution(e.target.value,state.project.composition.aspect);state.commit(p=>{p.composition.width=res.width;p.composition.height=res.height;});}if(e.target.dataset.compose==='fps')state.commit(p=>p.composition.fps=Number(e.target.value));}});
inspector.addEventListener('click',e=>{const a=e.target.dataset.inspectAction;if(!a)return;if(a==='split')state.splitSelected();if(a==='duplicate')state.duplicateSelection();if(a==='delete')state.deleteSelection();if(a==='use-global'){const l=selectedLyric();if(l)state.updateLyric(l.id,{styleOverride:null});}if(a==='add-keyframe'){const c=selectedClip();if(c)state.commit(p=>{const x=p.clips.find(z=>z.id===c.id),s={...p.titleStyle,...x.content.style};for(const property of ['x','y','scale','rotation','opacity','blur','fontSize','color','glow'])x.keyframes.push({id:uid('key'),property,timeUs:Math.max(0,state.playheadUs-x.startUs),value:s[property]??(property==='opacity'?1:0)});});}});
function applyStyleChange(key,value){const [scope,...rest]=key.split(':');const path=rest.join(':');if(scope==='global')state.commit(p=>setDeep(p.lyricStyle,path,value));else if(scope==='clip'){const c=selectedClip();if(!c||c.type!=='text')return;state.commit(p=>{const x=p.clips.find(z=>z.id===c.id);x.content.style=x.content.style||{};setDeep(x.content.style,path,value);});}}

function manualTapSync(){const sorted=[...state.project.lyrics].sort((a,b)=>a.startUs-b.startUs);if(!sorted.length)return;const cur=selectedLyric();let i=cur?sorted.findIndex(x=>x.id===cur.id):tapSyncIndex;if(i<0)i=0;const 