or:#535a68}.tx-phase-row span.active{color:#c7bbff}.tx-status pre{white-space:pre-wrap;max-height:120px;overflow:auto;font-size:9px;color:#aeb5c3;line-height:1.45;margin:9px 0 0}.hero-action{min-width:150px}.hero-action.working{animation:pulsebtn 1.2s ease-in-out infinite}@keyframes pulsebtn{50%{filter:brightness(1.12);box-shadow:0 0 22px rgba(255,66,104,.22)}}
dialog::backdrop{background:rgba(2,3,6,.78);backdrop-filter:blur(9px) saturate(.8)}
.toasts{right:16px;bottom:16px}.toast{background:#171a22;border-color:#353946;box-shadow:0 18px 60px rgba(0,0,0,.38)}
@media(max-width:1050px){.top-actions .secondary-save{display:none}.top-actions .ai-top-action{padding-inline:8px}.brand strong em{display:none}}
@media(max-width:820px) and (orientation:landscape){.topbar{padding-inline:7px}.brand{min-width:118px}.brand-mark{width:30px;height:30px}.brand strong{font-size:12px}.top-actions .ai-top-action,.top-actions .toolbar-text{display:none}.panel-content{padding:10px}.ai-section{padding:9px}.ai-launch{padding:8px!important}.modal-card{width:min(680px,94vw);max-height:88vh;padding:14px}.modal-hero{grid-template-columns:38px 1fr auto;gap:9px}.modal-icon{width:36px;height:36px}.modal-hero h2{font-size:16px}.tx-provider-card{padding:8px 9px;margin-bottom:8px}.tx-grid{gap:7px}.tx-notice{padding:7px 8px;margin-bottom:7px}.advanced-provider{margin:4px 0}.modal-actions{margin-top:9px}.timeline-tools button{padding:4px 6px}.transport{gap:5px}}
