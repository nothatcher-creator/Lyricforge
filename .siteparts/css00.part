:root{color-scheme:dark;--bg:#07080d;--panel:#0e1018;--panel2:#151823;--line:#242938;--soft:#8d95a8;--text:#edf0f6;--accent:#ff365c;--accent2:#8a5cff;--good:#39d98a;--warn:#ffb84a;--radius:12px;--left:330px;--right:330px;--track-h:42px;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--line);background:#171a24;color:var(--text);border-radius:8px;padding:7px 10px;cursor:pointer;transition:.16s ease}button:hover{background:#202432;border-color:#343a4d}button:active{transform:translateY(1px)}button.primary{background:linear-gradient(135deg,var(--accent),#d92c9f);border-color:transparent;font-weight:800;box-shadow:0 8px 30px rgba(255,54,92,.2)}button.active,.tool-rail button.active{border-color:#5b6070;background:#272b39;color:#fff}.icon-btn{min-width:34px}.divider{width:1px;height:22px;background:var(--line);display:inline-block}.app-shell{height:100%;display:grid;grid-template-rows:52px 42px minmax(240px,1fr) 52px minmax(190px,34vh);background:radial-gradient(circle at 45% -20%,#1e1735 0,#090a10 37%,#07080d 65%)}
.topbar{display:flex;align-items:center;gap:14px;padding:0 12px;border-bottom:1px solid var(--line);background:rgba(9,10,16,.94);backdrop-filter:blur(18px);z-index:20}.brand{display:flex;align-items:center;gap:9px;min-width:190px}.brand-mark{width:31px;height:31px;border-radius:9px;background:linear-gradient(145deg,#ff365c,#8a5cff);display:grid;place-items:center;font-size:12px;font-weight:900;box-shadow:0 4px 20px rgba(138,92,255,.28)}.brand>div:last-child{display:grid;line-height:1.06}.brand strong{font-size:14px}.brand span{color:var(--soft);font-size:10px;max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mobile-project,.mobile-left-close{display:none}.mobile-left-close{position:absolute;top:6px;right:7px;z-index:35;width:30px;height:30px;padding:0}.top-actions{display:flex;align-items:center;gap:5px;flex:1;justify-content:center}.status-pill{font-size:11px;color:#aeb6c8;border:1px solid var(--line);background:#10131b;border-radius:99px;padding:5px 9px;white-space:nowrap}
.guide{display:flex;align-items:center;justify-content:center;gap:6px;border-bottom:1px solid var(--line);background:#0b0d13}.guide button{border:0;background:transparent;display:flex;align-items:center;gap:7px;font-size:11px;color:#aeb4c3;padding:4px 8px}.guide button b{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;background:#1b1f2a;color:#cbd1de;font-size:10px}.guide button.done b{background:rgba(57,217,138,.16);color:var(--good);border:1px solid rgba(57,217,138,.28)}.guide button.current{color:#fff}.guide button.current b{background:var(--accent);color:#fff}.guide i{height:1px;width:26px;background:#292e3e}
.workspace{display:grid;grid-template-columns:var(--left) minmax(360px,1fr) var(--right);min-height:0}.panel{background:var(--panel);min-width:0;min-height:0;overflow:hidden}.left-panel{position:relative;display:grid;grid-template-columns:62px 1fr;border-right:1px solid var(--line)}.right-panel{position:relative;border-left:1px solid var(--line);display:grid;grid-template-rows:40px 1fr}.panel-title-row{display:flex;justify-content:space-between;align-items:center;padding:0 10px;border-bottom:1px solid var(--line);font-size:12px}.panel-title-row button{padding:3px 8px}.tool-rail{background:#090b11;border-right:1px solid var(--line);padding:7px 5px;display:flex;flex-direction:column;gap:4px;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none}.tool-rail::-webkit-scrollbar{display:none}.tool-rail button{border:0;background:transparent;display:grid;place-items:center;gap:2px;min-height:49px;font-size:17px;padding:5px 2px;color:#9aa2b5}.tool-rail button span{font-size:9px;font-weight:600}.panel-content{overflow:auto;padding:11px}.panel-content::-web