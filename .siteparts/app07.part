b(new Blob([exportLyrics(state.project.lyrics,b.dataset.exSub)],{type:'text/plain'}),`${state.project.name}.${b.dataset.exSub}`));$('#exProject').onclick=async()=>{const bundle=await createProjectBundle(state.project,getAsset);downloadBlob(bundle,`${state.project.name}.lyricforge`);};$('#exAudio').onclick=()=>downloadBlob(runtime.audioBlob,`${state.project.name}.${runtime.audioBlob.type.includes('wav')?'wav':'audio'}`);$('#exVideo').onclick=async()=>{const format=$('#exFormat').value,res=$('#exRes').value,fps=Number($('#exFps').value),vb=Number($('#exVb').value)*1e6;$('#exProgress').classList.remove('hidden');$('#exVideo').disabled=true;try{audio.pause();const result=await renderVideo({project:state.project,audioBlob:runtime.audioBlob,runtime:{assetElements:runtime.assetElements,frequencyData:()=>audio.frequencyData()},format,resolution:res,fps,videoBitrate:vb,audioBitrate:s.audioBitrate,onProgress:p=>{$('#exBar').style.width=`${Math.round(p*100)}%`;$('#exMsg').textContent=`Rendering ${Math.round(p*100)}%`;}});downloadBlob(result.blob,`${state.project.name}.${format==='mp4'?'mp4':'webm'}`);$('#exMsg').textContent=`Done · ${result.width}×${result.height}`;toast('Video export complete','good');}catch(err){$('#exMsg').textContent=err.message;toast(err.message,'bad');}finally{$('#exVideo').disabled=false;}};}

function showProjectMenu(){modalBody.innerHTML=`<div class="modal-card"><h2>Project</h2><p class="subtle">Create, open, save or duplicate the current LyricForge project.</p><div class="two-col"><button type="button" data-project-action="new">New project</button><button type="button" data-project-action="open">Open project</button><button type="button" class="primary" data-project-action="save">Save project</button><button type="button" data-project-action="save-as">Save As</button></div><div class="modal-actions"><button value="cancel">Close</button></div></div>`;modal.showModal();$$('[data-project-action]',modalBody).forEach(b=>b.onclick=()=>{const action=b.dataset.projectAction;modal.close();topAction(action);});}

function addMarker(){state.addMarker(state.playheadUs,`Marker ${state.project.markers.length+1}`);}
function frameStep(dir){const us=Math.round(1e6/state.project.composition.fps);state.setPlayhead(state.playheadUs+dir*us);audio.seekUs(state.playheadUs);}
function goLyric(dir){const {sorted,index}=activeLyricIndex();let i=index;if(i<0)i=0;i=Math.max(0,Math.min(sorted.length-1,i+dir));if(sorted[i]){state.setPlayhead(sorted[i].startUs);audio.seekUs(state.playheadUs);state.selectLyric(sorted[i].id);}}

async function topAction(action){if(action==='project-menu')showProjectMenu();if(action==='auto-transcribe'){leftTab='lyrics';renderLeft();showTranscriptionModal();}if(action==='new')showNewModal();if(action==='open')showOpenModal();if(action==='save')saveNow();if(action==='save-as'){const name=prompt('Project name',state.project.name);if(name){state.commit(p=>{p.id=uid('project');p.name=name;p.createdAt=new Date().toISOString();});saveNow();}}if(action==='undo')state.undo();if(action==='redo')state.redo();if(action==='export')showExportModal();if(action==='fullscreen')canvas.requestFullscreen?.();if(action==='toggle-guides'){runtime.guides=!runtime.guides;document.querySelector('[data-action="toggle-guides"]').classList.toggle('active',runtime.guides);renderFrame();}if(action==='fit-stage'){canvas.style.maxWidth='100%';canvas.style.maxHeight='100%';}if(action==='close-left-mobile')document.body.classList.remove('mobile-left-open');if(action==='collapse-right'){if(isCompactMobile()){const opening=!document.body.classList.contains('mobile-right-open');document.body.classList.toggle('mobile-right-open',opening);document.body.classList.remove('mobile-left-open','right-collapsed');document.querySelector('[data-action="collapse-right"]').textContent=opening?'×':'›';}else document.body.classList.toggle('right-collapsed');}if(action==='play'){if(audio.playing)audio.pause();else await audio.play();$('#playButton').textContent=audio.playing?'❚❚':'▶';}if(action==='stop'){audio.stop();state.setPlayhead(0);$('#playButton').textContent='▶';}if(action==='frame-back')frameStep(-1);if(action==='frame-forward')frameStep(1);if(action==='prev-lyric')goLyric(-1);if(action==='next-lyric')goLyric(1);if(action==='loop'){runtime.loopEnabled=!runtime.loopEnabled;const l=selectedLyric();runtime.loopRange=l?[l.startUs,l.endUs]:[0,projectDuration()];$('#loopButton').classList.toggle('active',runtime.loopEnabled);toast(runtime.loopEnabled?(l?'Looping selected lyric':'Looping composition'):'Loop off');}if(action==='add-marker')addMarker();if(action==='split')state.splitSelected();if(action==='duplicate')state.duplicateSelection();if(action==='delete')state.deleteSelection();}
document.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)topAction(b.dataset.action);const g=e.target.closest('[data-guide]');if(g){leftTab=g.dataset.guide==='adjust'?'effects':g.dataset.guide;renderLeft();}});
$$('.tool-rail button').forEach(b=>b.addEventListener('click',()=>{leftTab=b.dataset.tab;renderLeft();if(isCompactMobile()){document.body.classList.add('mobile-left-open');document.body.classList.remove('mobile-right-open');const rb=document.querySelector('[data-action="collapse-right"]');if(rb)rb.textContent='›';}}));
$('#fileInput').addEventListener('change',e=>importFiles(e.target.files));
$('#playbackRate').addEventListener('change',e=>audio.setRate(Number(e.target.value)));
$('#volume').addEventListener('input',e=>audio.setVolume(Number(e.target.value)));
$('#timelineZoom').addEventListener('input',renderTimeline);
timelineScroll.addEventListener('scroll',()=>{$('#trackHeaders').scrollTop=timelineScroll.scrollTop;});

for(const ev of ['dragenter','dragover'])document.addEventListener(ev,e=>{e.preventDefault();$('#dropOverlay').classList.add('show');});for(const ev of ['dragleave','drop'])document.addEventListener(ev,e=>{e.preventDefault();if(ev==='drop'){const fs=e.dataTransfer?.files;if(fs?.length)importFiles(fs);}$('#dropOverlay').classList.remove('show');});

window.addEventListener('keydown',async e=>{const tag=document.activeElement?.tagName;if(['INPUT','TEXTAREA','SELECT'].includes(tag))return;const mod=e.ctrlKey||e.metaKey;if(e.code==='Space'){e.preventDefault();topAction('play');}else if(mod&&e.key.toLowerCase()==='z'&&e.shiftKey){e.preventDefault();state.redo();}else if(mod&&e.key.toLowerCase()==='z'){e.preventDefault();state.undo();}else if(mod&&e.key.toLowerCase()==='s'){e.preventDefault();saveNow();}else if(mod&&e.key.toLowerCase()==='c')state.copySelection();else if(mod&&e.key.toLowerCase()==='v')state.paste();else if(mod&&e.key.toLowerCase()==='d'){e.preventDefault();state.duplicateSelection();}else if(e.key==='Delete'||e.key==='Backspace')state.deleteSelection();else if(e.key==='ArrowLeft'){state.setPlayhead(state.playheadUs-(e.shiftKey?100_000:10_000));audio.seekUs(state.playheadUs);}else if(e.key==='ArrowRight'){state.setPlayhead(state.playheadUs+(e.shiftKey?100_000:10_000));audio.seekUs(state.playheadUs);}else if(e.key.toLowerCase()==='s')state.splitSelected();else if(e.key.toLowerCase()==='m')addMarker();});
window.addEventListener('beforeunload',e=>{if(state.dirty){e.preventDefault();e.returnValue='';}});

function setupPanelResizer(el,side){let startX=0,start=0;el.addEventListener('pointerdown',e=>{startX=e.clientX;start=parseFloat(getComputedStyle(document.documentElement).getPropertyValue(side==='left'?'--left':'--right'))||330;el.setPointerCapture?.(e.pointerId);const move=ev=>{const delta=ev.clientX-startX;const v=Math.max(210,Math.min(520,start+(side==='left'?delta:-delta)));document.documentElement.style.setProperty(side==='left'?'--left':'--right',`${v}px`);};const up=()=>{window.removeEventListener('pointermove',move);window.removeEventListener('pointerup',up);};window.addEventListener('pointermove',move);window.addEventListener('pointerup',up);});}
setupPanelResizer($('#leftResizer'),'left');setupPanelResizer($('#rightResizer'),