kit-scrollbar,.timeline-scroll::-webkit-scrollbar{width:8px;height:8px}.panel-content::-webkit-scrollbar-thumb,.timeline-scroll::-webkit-scrollbar-thumb{background:#2c3141;border-radius:99px}.section{border-bottom:1px solid var(--line);padding:0 0 12px;margin-bottom:12px}.section:last-child{border:0}.section h3{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#9ca4b8;margin:0 0 9px}.subtle{font-size:11px;color:var(--soft);line-height:1.4}.stack{display:grid;gap:7px}.row{display:flex;gap:7px;align-items:center}.row>*{min-width:0}.row.spread{justify-content:space-between}.field{display:grid;gap:5px;font-size:11px;color:#aeb5c5;margin-bottom:8px}.field input,.field select,.field textarea,input[type=text],input[type=url],input[type=password],input[type=number],select,textarea{width:100%;background:#090b12;border:1px solid #2a3040;color:var(--text);border-radius:7px;padding:7px 8px;outline:none}.field input:focus,.field select:focus,.field textarea:focus,textarea:focus,input:focus{border-color:#666ee8;box-shadow:0 0 0 2px rgba(102,110,232,.12)}input[type=color]{padding:1px;height:31px}input[type=range]{accent-color:var(--accent)}textarea{resize:vertical;min-height:110px}.drop-card{border:1px dashed #41485c;background:linear-gradient(145deg,rgba(255,54,92,.04),rgba(138,92,255,.04));border-radius:10px;padding:15px;text-align:center;display:grid;gap:7px}.asset-card,.lyric-row,.preset-card{border:1px solid var(--line);background:#12151e;border-radius:9px;padding:8px}.asset-card{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:7px}.asset-icon{width:30px;height:30px;border-radius:7px;background:#202536;display:grid;place-items:center}.asset-card b{font-size:11px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.asset-card small{color:var(--soft);font-size:9px}.preset-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.preset-card{cursor:pointer;min-height:62px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}.preset-card:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,var(--p-bg),transparent 70%),radial-gradient(circle at 80% 15%,var(--p-accent),transparent 38%);opacity:.65}.preset-card>*{position:relative}.preset-card b{font-size:11px}.preset-card span{font-size:9px;color:#bec4d1}.lyric-list{display:grid;gap:5px}.lyric-row{padding:7px;cursor:pointer;display:grid;grid-template-columns:42px 1fr auto;gap:6px;align-items:center}.lyric-row.selected{border-color:var(--accent);background:#1b1720}.lyric-row time{font-size:9px;color:#8f97aa}.lyric-row input{padding:4px 5px;border:0;background:transparent}.confidence{font-size:9px;border-radius:99px;padding:2px 5px;background:#212636;color:#aeb5c7}.confidence.low{background:rgba(255,184,74,.13);color:var(--warn)}
.stage-wrap{min-width:0;min-height:0;display:grid;grid-template-rows:38px minmax(0,1fr);background:#08090e}.stage-toolbar{border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 10px;color:#9ca4b6;font-size:11px}.stage-actions{display:flex;gap:5px}.stage{position:relative;min-height:0;display:grid;place-items:center;padding:18px;overflow:hidden;background:linear-gradient(45deg,#0b0d12 25%,transparent 25%),linear-gradient(-45deg,#0b0d12 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#0b0d12 75%),linear-gradient(-45deg,transparent 75%,#0b0d12 75%);background-size:22px 22px;background-position:0 0,0 11px,11px -11px,-11px 0}#previewCanvas{display:block;max-width:100%;max-height:100%;width:auto;height:auto;aspect-ratio:16/9;background:#000;box-shadow:0 22px 80px rgba(0,0,0,.58),0 0 0 1px #2a2f3d;touch-action:none}.drop-overlay{position:absolute;inset:18px;border:2px dashed #6b6f88;border-radius:16px;background:rgba(8,9,14,.9);display:none;place-items:center;text-align:center;align-content:center;gap:5px;color:white;z-index:10}.drop-overlay.show{display:grid}.drop-overlay span{font-size:11