p:7px}.three-col{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.color-field{display:grid;grid-template-columns:1fr 40px;gap:5px}.word-table{display:grid;gap:4px}.word-row{display:grid;grid-template-columns:1fr 62px 62px;gap:4px}.word-row input{padding:4px;font-size:9px}
.modal-card{width:min(720px,85vw);max-height:78vh;overflow:auto;padding:18px;background:#10131c;border:1px solid #303649;border-radius:14px;color:var(--text)}dialog{border:0;background:transparent;padding:0}dialog::backdrop{background:rgba(0,0,0,.72);backdrop-filter:blur(5px)}.modal-card h2{margin:0 0 6px;font-size:20px}.modal-actions{display:flex;justify-content:flex-end;gap:7px;margin-top:15px}.project-row{display:grid;grid-template-columns:1fr auto;gap:8px;border:1px solid var(--line);border-radius:9px;padding:9px;margin:6px 0}.progress{height:7px;border-radius:99px;background:#252a37;overflow:hidden}.progress>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2))}.toasts{position:fixed;right:14px;bottom:14px;display:grid;gap:7px;z-index:100}.toast{max-width:330px;background:#171b25;border:1px solid #323849;border-radius:10px;padding:9px 11px;box-shadow:0 10px 40px rgba(0,0,0,.35);font-size:11px;animation:toastin .2s ease}.toast.good{border-color:rgba(57,217,138,.35)}.toast.bad{border-color:rgba(255,77,96,.5)}@keyframes toastin{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.hidden{display:none!important}.right-collapsed{--right:38px}.right-collapsed .right-panel .panel-content,.right-collapsed .right-panel strong{display:none}.right-collapsed .right-panel .panel-title-row{padding:0;justify-content:center}.left-collapsed{--left:62px}.left-collapsed .left-panel .panel-content{display:none}
@media(max-width:1050px){:root{--left:250px;--right:270px}.brand{min-width:auto}.brand>div:last-child span{display:none}.topbar button{padding:6px 7px}.guide span{display:none}.guide i{width:14px}.workspace{grid-template-columns:var(--left) minmax(300px,1fr) var(--right)}.timeline-shell{grid-template-columns:135px 1fr}.track-head .name{font-size:9px}.transport{gap:10px}.transport-right label:first-child{display:none}}
@media(max-width:820px) and (orientation:landscape){.app-shell{grid-template-rows:46px minmax(120px,1fr) 44px minmax(96px,30vh)}.guide{display:none}.workspace{grid-template-columns:62px minmax(300px,1fr) 44px}.left-panel{grid-template-columns:62px 0}.left-panel .panel-content,.right-panel .panel-content,.right-panel strong{display:none}.mobile-left-open .workspace{grid-template-columns:min(310px,46vw) minmax(250px,1fr) 44px}.mobile-left-open .left-panel{grid-template-columns:62px minmax(0,1fr)}.mobile-left-open .left-panel .panel-content{display:block;padding-top:42px}.mobile-left-open .mobile-left-close{display:block}.mobile-right-open .workspace{grid-template-columns:62px minmax(250px,1fr) min(310px,46vw)}.mobile-right-open .right-panel{grid-template-rows:40px minmax(0,1fr)}.mobile-right-open .right-panel .panel-content{display:block}.mobile-right-open .right-panel strong{display:inline}.stage{padding:8px}.mobile-project{display:block;padding:6px 8px}.topbar{gap:7px;padding:0 8px}.top-actions{justify-content:flex-end}.top-actions button:nth-child(-n+4){display:none}.status-pill{display:none}.tool-rail button{min-height:42px}.timeline-shell{grid-template-columns:110px 1fr}.snap-controls label:first-child,.snap-controls label:nth-child(2){display:flex}.snap-controls label:last-child{display:none}.transport-right label:first-child{display:flex}.transport-right label:last-child{display:none}.transport{gap:7px;padding:0 7px}.transport time{min-width:132px}}

.panel-resizer{position:absolute;top:0;bottom:0;width:7px;z-index:30;cursor:col-resize}.panel-resizer.right-edge{right:-4px}.panel-resizer.left-edge{left:-4px}.panel-resizer:hover{background:rgba(138,92,255,.35)}details{border:1px solid var(--line);border-radius:8px;padding:7px 8px;margin-top:8px}summary{cursor:pointer;font-size:10