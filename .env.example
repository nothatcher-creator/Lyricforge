API_PORT=3002
# CHROMIUM_PATH=/usr/bin/chromium
# RENDER_CONCURRENCY=2
# ALIGNMENT_URL=http://127.0.0.1:8000/align
# ALIGNMENT_TOKEN=
# CORS_ORIGIN=https://your-editor.example
