# ALIGNMENT_PYTHON=/absolute/path/to/python
# LOCAL_ALIGNMENT_ORIGIN=http://127.0.0.1:8000
# ALIGNMENT_HEALTH_URL=
# ALIGNMENT_LANGUAGES=en
# ALIGNMENT_TIMEOUT_MS=900000
# ALIGN_MODEL_DIR=/absolute/path/to/cached/model
