{
  "signature": "lyricforge-preset",
  "schemaVersion": 1,
  "id": "vintage-film",
  "name": "Vintage Film",
  "author": "LyricForge",
  "description": "First-party Vintage Film LyricForge preset.",
  "category": "Retro",
  "tags": [
    "vintage film",
    "retro",
    "lyricforge"
  ],
  "version": "1.0.0",
  "minAppVersion": "0.3.7",
  "accent": "#e9d1a1",
  "style": {
    "fontFamily": "\"Playfair Display\", Georgia, serif",
    "fontSize": 76,
    "fontWeight": 600,
    "italic": false,
    "underline": false,
    "textTransform": "none",
    "letterSpacing": 0,
    "wordSpacing": 0,
    "lineHeight": 1.1,
    "align": "center",
    "color": "#ffffff",
    "activeColor": "#e9d1a1",
    "previousColor": "#a7adbd",
    "upcomingColor": "#d7d9e0",
    "opacity": 1,
    "strokeColor": "#06070b",
    "strokeWidth": 4,
    "shadowColor": "rgba(0,0,0,.65)",
    "shadowBlur": 18,
    "glow": 0,
    "blur": 0,
    "backgroundColor": "rgba(0,0,0,.18)",
    "backgroundOpacity": 0,
    "radius": 16,
    "padding": 18,
    "x": 0.5,
    "y": 0.72,
    "scale": 1,
    "rotation": 0,
    "maxWidth": 0.82,
    "karaoke": "progressive-fill",
    "entrance": {
      "name": "fade",
      "durationMs": 280,
      "intensity": 1
    },
    "idle": {
      "name": "none",
      "durationMs": 1000,
      "intensity": 1
    },
    "exit": {
      "name": "fade",
      "durationMs": 240,
      "intensity": 1
    }
  },
  "background": {
    "type": "gradient",
    "value": [
      "#2d2118",
      "#06070b"
    ],
    "fit": "cover",
    "blur": 0,
    "brightness": 1,
    "contrast": 1,
    "saturation": 1,
    "hue": 0,
    "opacity": 1,
    "vignette": 0.25
  },
  "visualizer": {
    "type": "none",
    "enabled": false,
    "sensitivity": 1,
    "smoothing": 0.8,
    "size": 0.75,
    "y": 0.55,
    "opacity": 0.55,
    "color": "#e9d1a1"
  },
  "videoEffects": {
    "filmGrain": 0.46,
    "vhs": 0,
    "scanlines": 0,
    "rgbSplit": 0,
    "bloom": 0,
    "shake": 0,
    "strobe": 0,
    "monochrome": 0,
    "sepia": 0.42,
    "posterize": 0,
    "contrastCrush": 0,
    "tint": 0,
    "temperature": 0,
    "oldFilm": 0.52,
    "crt": 0,
    "chromaticAberration": 0,
    "beatPulse": 0,
    "vignette": 0.46,
    "tintColor": "#ff3b7b"
  }
}
