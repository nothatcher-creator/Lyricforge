{
  "name": "lyricforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "studio": "remotion studio src/video/index.ts --no-open --port 3001",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src server tests *.ts *.json",
    "setup:alignment": "node scripts/setup-alignment.mjs",
    "alignment:serve": "node scripts/serve-alignment.mjs",
    "test:alignment": "node scripts/test-alignment.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "meyda": "^5.6.3",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.541",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
